# ==============================================
# ZOHO API CREDENTIALS (see README.md for how to get these)
# ==============================================

# Your Zoho data center's accounts/API domains.
# India DC (matches your zohoapis.in URLs in the original script):
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# From the Zoho API Console (Self Client)
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here

# Generated once via the OAuth consent/grant flow, see README.md.
# This one refresh token is reused forever to mint short-lived access tokens.
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Books organization ID
ZOHO_BOOKS_ORG_ID=60057137209

# ==============================================
# APP SETTINGS
# ==============================================
PORT=3000
